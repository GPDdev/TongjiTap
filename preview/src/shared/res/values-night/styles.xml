<resources>
    <style name="BaseTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:textSize">16sp</item>
        <item name="android:alertDialogTheme">@style/TongjiDialog</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:navigationBarColor">@color/app_background</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="TongjiDialog" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textSize">16sp</item>
        <item name="android:buttonBarButtonStyle">@style/DialogButton</item>
    </style>
</resources>
