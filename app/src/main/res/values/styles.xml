<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="BaseTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:textSize">16sp</item>
        <item name="android:alertDialogTheme">@style/TongjiDialog</item>
        <item name="android:colorAccent">#2563EB</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F5F7FB</item>
        <item name="android:navigationBarColor">#152035</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="AppTheme" parent="BaseTheme" />
    <style name="TongjiDialog" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#2563EB</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAppearanceMedium">@style/BodyText</item>
        <item name="android:textAppearanceSmall">@style/BodyText</item>
        <item name="android:buttonBarButtonStyle">@style/DialogButton</item>
    </style>
    <style name="BodyText" parent="android:style/TextAppearance.Material.Body1">
        <item name="android:textSize">16sp</item>
    </style>
    <style name="DialogButton" parent="android:style/Widget.Material.Light.Button.Borderless">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/dialog_button_text</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
